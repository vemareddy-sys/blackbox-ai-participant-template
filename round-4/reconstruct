      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "ðŸŒŸ Weighted Ensemble (SLSQP):\n",
            "Models: ['Polynomial_Regression', 'ExtraTrees', 'Random_Forest']\n",
            "Weights: [np.float64(0.8405), np.float64(0.0), np.float64(0.1595)]\n",
            "Validation MAE: 0.01403 | RMSE: 0.03291 | R2: 0.86833 | Max Error: 0.11981\n"
          ]
        }
      ],
      "source": [
        "from scipy.optimize import minimize\n",
        "\n",
        "top_3_names = df_results['model'].head(3).tolist()\n",
        "top_3_models = [fitted_models[n] for n in top_3_names]\n",
        "preds_matrix = np.column_stack([m.predict(X_val) for m in top_3_models])\n",
        "\n",
        "# Optimize convex weights to minimize Validation MAE\n",
        "def loss_fn(w):\n",
        "    return float(np.mean(np.abs(y_val.to_numpy() - preds_matrix @ w)))\n",
        "\n",
        "bnds = [(0.0, 1.0) for _ in range(len(top_3_models))]\n",
        "cons = [{'type': 'eq', 'fun': lambda w: np.sum(w) - 1.0}]\n",
        "opt_w = minimize(loss_fn, [1/3, 1/3, 1/3], method='SLSQP', bounds=bnds, constraints=cons).x\n",
        "\n",
        "weighted_preds = preds_matrix @ opt_w\n",
        "ens_mae = mean_absolute_error(y_val, weighted_preds)\n",
        "ens_rmse = np.sqrt(mean_squared_error(y_val, weighted_preds))\n",
        "ens_r2 = r2_score(y_val, weighted_preds)\n",
        "ens_max = np.max(np.abs(y_val.to_numpy() - weighted_preds))\n",
        "\n",
        "print(f'ðŸŒŸ Weighted Ensemble (SLSQP):')\n",
        "print(f'Models: {top_3_names}')\n",
        "print(f'Weights: {[round(w, 4) for w in opt_w]}')\n",
        "print(f'Validation MAE: {ens_mae:.5f} | RMSE: {ens_rmse:.5f} | R2: {ens_r2:.5f} | Max Error: {ens_max:.5f}')\n"
      ]
